---
import SiteShell from '../layouts/SiteShell.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
---
<SiteShell>
  <SiteHeader current="about" />
  <main id="content" class="reading scaffold">
    <p class="eyebrow">Hello there <span aria-hidden="true">↘</span></p>
    <h1>About<span aria-hidden="true">.</span></h1>
    <div class="note">
      <p>I’m Barnaby, a builder of things, and occasionally stuff.</p>
      <p>I’ve spent over 20 years building web apps, native apps, desktop apps - basically all the apps. Done a fair share of project and team leading too.</p>
      <p>Currently exploring the depths of AI and software development at <a href="https://www.thinkmill.com.au/">Thinkmill</a>.</p>
    </div>
    <a class="tactile" href="https://x.com/barneybishop">x / twitter <span aria-hidden="true">↗</span></a>
  </main>
  <SiteFooter />
</SiteShell>
<style>
  h1 span {
    color: var(--color-link);
  }

  .note {
    padding: var(--space-3);
    border: var(--border-strong);
    background: var(--color-yellow);
    box-shadow: var(--shadow-hard);
    border-radius: var(--radius-card);
  }

  .note p {
    margin: 0;
  }

  .note p + p {
    margin-top: var(--space-2);
  }
</style>
