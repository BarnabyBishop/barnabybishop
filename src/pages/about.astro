---
import SiteShell from '../layouts/SiteShell.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
---
<SiteShell title="About — Barnaby Bishop" description="About page for Barnaby Bishop.">
  <SiteHeader current="about" />
  <main id="content" class="reading scaffold">
    <p class="eyebrow">Hello there <span aria-hidden="true">↘</span></p>
    <h1>About<span aria-hidden="true">.</span></h1>
    <div class="note"><p>This page is still taking shape.</p><p>A little more about Barnaby will live here soon.</p></div>
    <a class="tactile" href="/">Back to home <span aria-hidden="true">↗</span></a>
  </main>
  <SiteFooter />
</SiteShell>
<style>
  h1 span {
    color: var(--color-link);
  }

  .note {
    padding: var(--space-3);
    border: var(--border-strong);
    background: var(--color-yellow);
    box-shadow: var(--shadow-hard);
    border-radius: var(--radius-card);
  }

  .note p {
    margin: 0;
  }

  .note p + p {
    margin-top: var(--space-2);
  }
</style>
