---
import SiteShell from '../layouts/SiteShell.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import Decorations from '../components/Decorations.astro';
import { posts } from '../lib/posts';
const date = new Intl.DateTimeFormat('en-GB', { dateStyle: 'medium', timeZone: 'UTC' });
---
<SiteShell>
  <SiteHeader current="home" />
  <main id="content" class="home">
    <section class="hero" aria-labelledby="name">
      <Decorations area="hero" />
      <h1 id="name"><button class="name-play" type="button" title="Play with the name and shapes"><span class="highlight cluster-piece">Barnaby</span> <span class="surname cluster-piece">Bishop</span></button></h1>
    </section>
    <section class="writing" aria-labelledby="writing">
      <Decorations area="writing" />
      <h2 id="writing">Writing</h2>
      {posts.length ? <ol>{posts.map((post) => <li class="card">
        <time datetime={post.published}>{date.format(new Date(post.published))}</time>
        <h3><a href={`/${post.slug}`}>{post.title}</a></h3>
        <span class="arrow" aria-hidden="true">→</span>
      </li>)}</ol> : <p class="card empty">Nothing published just yet.</p>}
    </section>
  </main>
  <SiteFooter />
</SiteShell>

<style>
  /* Page sizing shared with the decorative shapes. */
  .home {
    /* --n is one "design pixel": 1px when the name is at its full 10rem. */
    --name-size: calc(var(--site-scale) * clamp(3.5rem, 1.75rem + 8 * var(--fluid-unit), 10rem));
    --n: calc(var(--name-size) / 160);
    --name-top: calc(120 * var(--n));
    --inset: max(var(--gutter), (100% - var(--width-site)) / 2);
  }

  .hero, .writing {
    position: relative;
    padding-inline: var(--inset);
  }

  /* Hero and name */
  .hero {
    min-height: calc(var(--name-top) + 500 * var(--n));
  }

  h1 {
    position: relative;
    z-index: 1;
    margin: 0;
    padding-top: var(--name-top);
    font-size: var(--name-size);
    line-height: .92;
    letter-spacing: -.05em;
    pointer-events: none;
  }

  h1 span {
    display: block;
    width: max-content;
    max-width: none;
  }

  .name-play {
    display: block;
    width: max-content;
    max-width: 100%;
    overflow: visible;
    padding: 0;
    border: 0;
    background: none;
    color: inherit;
    font: inherit;
    letter-spacing: inherit;
    text-align: start;
    white-space: nowrap;
    cursor: pointer;
    pointer-events: auto;
    touch-action: manipulation;
    -webkit-tap-highlight-color: transparent;
  }

  .name-play:focus-visible {
    outline-offset: .15em;
  }

  .highlight {
    margin: 0 0 .06em -.14em;
    padding: .02em .14em .08em;
    background: var(--color-teal);
    border: var(--border-strong);
    border-radius: var(--radius-card);
    box-shadow: calc(8px * var(--site-scale)) calc(8px * var(--site-scale)) 0 var(--color-shadow);
    rotate: -2deg;
    --spread-x: calc(-10 * var(--n));
    --spread-y: calc(-14 * var(--n));
    --spread-duration: 550ms;
  }

  .surname {
    --spread-x: calc(22 * var(--n));
    --spread-y: calc(14 * var(--n));
    --spread-duration: 700ms;
  }

  /* Writing list and cards */
  .writing {
    padding-block: var(--space-3) var(--space-5);
  }

  h2 {
    position: relative;
    margin: 0 0 var(--space-3);
    font-size: var(--text-section);
  }

  ol {
    position: relative;
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: calc(1.25rem * var(--site-scale));
  }

  .card {
    position: relative;
    background: var(--color-surface);
    border: var(--border-strong);
    border-radius: var(--radius-card);
    box-shadow: var(--shadow-hard);
  }

  li {
    display: grid;
    grid-template-columns: calc(8.5rem * var(--site-scale)) minmax(0, 1fr) auto;
    align-items: center;
    gap: var(--space-3);
    padding: calc(1.25rem * var(--site-scale)) calc(1.75rem * var(--site-scale));
  }

  time {
    font-size: var(--text-small);
  }

  h3 {
    margin: 0;
    font-size: calc(var(--site-scale) * clamp(1.25rem, 1rem + var(--fluid-unit), 1.65rem));
    letter-spacing: -.02em;
  }

  h3 a {
    color: var(--color-ink);
    text-decoration: none;
  }

  h3 a::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
  }

  .arrow {
    font-size: calc(1.5rem * var(--site-scale));
    font-weight: 700;
  }

  /* Card interactions */
  li:hover {
    translate: -2px -2px;
    box-shadow: calc(var(--shadow-offset) + 2px) calc(var(--shadow-offset) + 2px) 0 var(--color-shadow);
  }

  li:hover h3 a {
    text-decoration: underline;
    text-decoration-thickness: .1em;
  }

  li:has(a:focus-visible) {
    outline: 3px solid var(--color-focus);
    outline-offset: 4px;
  }

  h3 a:focus-visible {
    outline: none;
  }

  /* Empty writing list */
  .empty {
    position: relative;
    margin: 0;
    padding: calc(1.25rem * var(--site-scale)) calc(1.75rem * var(--site-scale));
  }

  @media (prefers-reduced-motion: no-preference) {
    .hero :global(.cluster-piece) {
      transform: translate(calc(var(--spread-x) * var(--cluster-spread, 0)), calc(var(--spread-y) * var(--cluster-spread, 0)));
      transition: transform var(--spread-duration) cubic-bezier(.2, .8, .2, 1);
    }

    .hero:has(.name-play:focus-visible, :global(.cluster-shape:focus-visible)) {
      --cluster-spread: 1;
    }

    @media (hover: hover) {
      .hero:has(.name-play:hover, :global(.cluster-shape:hover)) {
        --cluster-spread: 1;
      }
    }

    @media (hover: none) {
      .hero:has(.name-play:is(:hover, :focus), :global(.cluster-shape:is(:hover, :focus))) :global(.cluster-piece) {
        animation: cluster-tap calc(2 * var(--spread-duration)) cubic-bezier(.2, .8, .2, 1);
      }

      /* Releasing each tap starts a fresh cycle, including on sticky hover. */
      .hero:has(.name-play:active, :global(.cluster-shape:active)) :global(.cluster-piece) {
        animation: none;
      }
    }

    li {
      transition: translate var(--motion-duration) var(--motion-easing), box-shadow var(--motion-duration) var(--motion-easing);
    }
  }

  @keyframes cluster-tap {
    0%, 100% { transform: translate(0, 0); }
    30%, 50% { transform: translate(var(--spread-x), var(--spread-y)); }
  }

  /* Keep decorative overspill out of the document's scrollable width on
     phones and tablets, without clipping the vertical scroll effects. */
  @media (max-width: 64rem) {
    .home {
      overflow-x: clip;
    }
  }

  @media (max-width: 40rem) {
    .home {
      --name-top: calc(230 * var(--n));
    }

    li {
      grid-template-columns: minmax(0, 1fr);
      gap: calc(.25rem * var(--site-scale));
      padding: calc(1rem * var(--site-scale)) calc(1.25rem * var(--site-scale));
    }

    .arrow {
      display: none;
    }
  }
</style>
