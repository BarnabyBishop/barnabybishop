---
// Memphis shapes for the homepage. Sizes and offsets are written in "design pixels"
// (the 1440px mock-up) and multiplied by --n, which tracks the size of the name.
interface Props { area: 'hero' | 'writing' }
const { area } = Astro.props;
const squiggle = 'M5 25q13.75-22 27.5 0t27.5 0 27.5 0 27.5 0 27.5 0 27.5 0 27.5 0 27.5 0';
// An open grid: lines overhang the last crossing by half a cell, so there's no outer border.
const gridSize = 540, cell = 26;
const gridLines = Array.from({ length: Math.ceil((gridSize - cell / 2) / cell) }, (_, i) => cell / 2 + i * cell)
  .flatMap((at) => [`M${at} 0V${gridSize}`, `M0 ${at}H${gridSize}`]).join('');
---
<div class:list={['decorations', area]} aria-hidden="true">
  {area === 'hero' ? <>
    <svg class="shape blue-squiggle" viewBox="0 0 220 50" focusable="false"><path d={squiggle} fill="none" stroke="var(--color-blue)" stroke-width="10" /></svg>
    <svg class="shape plus" viewBox="0 0 40 40" focusable="false"><path d="M20 5v30M5 20h30" fill="none" stroke="var(--color-pink)" stroke-width="7" /></svg>
    <svg class="shape circle" viewBox="0 0 100 100" focusable="false"><circle cx="50" cy="50" r="46" fill="var(--color-pink)" /></svg>
    <svg class="shape dots" viewBox="0 0 225 190" focusable="false"><defs><pattern id="hero-dots" width="16" height="16" patternUnits="userSpaceOnUse"><circle cx="8" cy="8" r="2.6" fill="var(--color-ink)" /></pattern></defs><rect width="225" height="190" fill="url(#hero-dots)" stroke="none" /></svg>
    <svg class="shape pill-shape" viewBox="0 0 140 44" focusable="false"><rect x="3" y="3" width="134" height="38" rx="19" fill="var(--color-blue)" /></svg>
    <svg class="shape ink-squiggle" viewBox="0 0 220 50" focusable="false"><path d={squiggle} fill="none" stroke-width="7" /></svg>
    <svg class="shape triangle" viewBox="0 0 100 85" focusable="false"><path d="M50 4 96 81H4Z" fill="var(--color-yellow)" /></svg>
  </> : <>
    <svg class="shape grid" viewBox={`0 0 ${gridSize} ${gridSize}`} focusable="false"><path d={gridLines} fill="none" stroke-width="2" stroke-opacity=".5" /></svg>
    <svg class="shape half" viewBox="0 0 100 50" focusable="false"><path d="M4 46a46 46 0 0 1 92 0Z" fill="var(--color-teal)" /></svg>
  </>}
</div>
<style>
  .decorations {
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
  }

  .shape {
    position: absolute;
    overflow: visible;
    stroke: var(--color-ink);
    stroke-width: 4;
    stroke-linejoin: round;
    stroke-linecap: round;
    rotate: var(--turn, 0deg);
  }

  .blue-squiggle {
    width: calc(280 * var(--n));
    left: calc(-70 * var(--n));
    top: calc(93 * var(--n));
    --turn: -24deg;
    --drift: 40px;
  }

  .plus {
    width: calc(44 * var(--n));
    left: 47%;
    top: calc(53 * var(--n));
    --drift: -30px;
  }

  .circle {
    width: calc(220 * var(--n));
    right: calc(150 * var(--n));
    top: calc(33 * var(--n));
    --drift: 50px;
  }

  .dots {
    width: calc(260 * var(--n));
    right: calc(-30 * var(--n));
    top: calc(153 * var(--n));
    --drift: 25px;
  }

  .pill-shape {
    width: calc(170 * var(--n));
    right: calc(300 * var(--n));
    top: calc(var(--name-top) + 283 * var(--n));
    --turn: -28deg;
    --drift: -60px;
  }

  .ink-squiggle {
    width: calc(340 * var(--n));
    right: calc(-40 * var(--n));
    top: calc(var(--name-top) + 423 * var(--n));
    --turn: -14deg;
    --drift: -40px;
  }

  .triangle {
    width: calc(300 * var(--n));
    left: calc(var(--inset) - 120 * var(--n));
    top: calc(var(--name-top) + 90 * var(--n));
    stroke-width: 2.6;
    --turn: -45deg;
    --drift: 35px;
  }

  .grid {
    width: calc(540 * var(--n));
    left: calc(-100 * var(--n));
    top: calc(30 * var(--n));
    --turn: -14deg;
    --drift: 30px;
  }

  .half {
    width: calc(140 * var(--n));
    right: calc(-30 * var(--n));
    top: calc(330 * var(--n));
    --turn: -20deg;
    --drift: -50px;
  }

  /* On phones the name fills the width, so the top shapes move above it. */

  @media (max-width: 40rem) {
    .blue-squiggle {
      width: calc(300 * var(--n));
      left: calc(-90 * var(--n));
      top: calc(50 * var(--n));
    }

    .plus {
      left: 52%;
      top: calc(80 * var(--n));
    }

    .circle {
      width: calc(170 * var(--n));
      right: calc(60 * var(--n));
      top: calc(20 * var(--n));
    }

    .dots {
      width: calc(220 * var(--n));
      right: calc(-50 * var(--n));
      top: calc(110 * var(--n));
    }

    .pill-shape {
      right: calc(40 * var(--n));
      top: calc(var(--name-top) + 340 * var(--n));
    }

    .ink-squiggle {
      width: calc(380 * var(--n));
      right: calc(-80 * var(--n));
      top: calc(var(--name-top) + 470 * var(--n));
    }

    .half {
      top: auto;
      bottom: calc(-40 * var(--n));
      right: calc(30 * var(--n));
    }
  }

  /* A gentle, CSS-only parallax: each shape drifts at its own rate as the page scrolls. */

  @keyframes drift {
    to {
      translate: 0 var(--drift, 0);
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    @supports (animation-timeline: scroll()) {
      /* Longhands on purpose: the CSS minifier folds a shorthand plus timeline into an invalid shorthand. */

      .shape {
        animation-name: drift;
        animation-timing-function: linear;
        animation-fill-mode: both;
        animation-timeline: scroll(root);
        animation-range: 0 1200px;
      }
    }
  }
</style>
